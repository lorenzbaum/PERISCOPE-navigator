{
  "name": "periscope-navigator",
  "version": "0.7.6",
  "description": "Recommender system for evaluating and designing privacy-friendly platform business models (PERISCOPE project, ICIS 2024)",
  "homepage": "https://privacy.wiim-research.de/",
  "repository": {
    "type": "git",
    "url": "https://github.com/lorenzbaum/PERISCOPE-navigator.git"
  },
  "author": "Lorenz Baum <baum@wiwi.uni-frankfurt.de>",
  "contributors": [
    "Björn Hanneke",
    "Oliver Hinz"
  ],
  "license": "MIT",
  "keywords": [
    "privacy",
    "business-models",
    "recommender-system",
    "conjoint-analysis",
    "gdpr",
    "periscope",
    "icis2024",
    "angular"
  ],
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --localize",
    "deploy": "npm run angular.json:localize && ng deploy && npm run angular.json:delocalize",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "i18n": "npm run i18n:extract && npm run i18n:upload && npm run i18n:download",
    "i18n:extract": "ng extract-i18n --output-path src/locale --format xlf2",
    "i18n:upload": "  localazy upload           -d src/locale",
    "i18n:download": "localazy download         -d src/locale",
    "angular.json:localize": "  json -I -f angular.json -e \"this.projects.navigator.architect.build.options.localize = true \"",
    "angular.json:delocalize": "json -I -f angular.json -e \"this.projects.navigator.architect.build.options.localize = false\"",
    "analyzer": "python analyzer.py"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.25",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.25",
    "@angular/compiler": "^21.2.25",
    "@angular/core": "^21.2.25",
    "@angular/fire": "^21.0.0",
    "@angular/forms": "^21.2.25",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.2.25",
    "@angular/platform-browser-dynamic": "^21.2.25",
    "@angular/router": "^21.2.25",
    "@angular/service-worker": "^21.2.25",
    "chart.js": "^2.9.4",
    "chartjs-gauge": "^0.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1",
    "firebase": "^12.18.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.29",
    "@angular/cli": "~21.2.29",
    "@angular/compiler-cli": "^21.2.25",
    "@angular/localize": "^21.2.25",
    "@localazy/cli": "^1.7.14",
    "@types/chart.js": "^2.9.38",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.1.0",
    "json": "^11.0.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.9.3"
  }
}