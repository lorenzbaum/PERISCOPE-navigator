{
  "name": "navigator",
  "version": "0.6.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --localize",
    "deploy": "npm run angular.json:localize && ng deploy && npm run angular.json:delocalize",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "i18n": "npm run i18n:extract && npm run i18n:upload && npm run i18n:download",
    "i18n:extract": "ng extract-i18n --output-path src/locale --format xlf2",
    "i18n:upload": "  localazy upload           -d src/locale",
    "i18n:download": "localazy download         -d src/locale",
    "angular.json:localize": "  json -I -f angular.json -e \"this.projects.navigator.architect.build.options.localize = true \"",
    "angular.json:delocalize": "json -I -f angular.json -e \"this.projects.navigator.architect.build.options.localize = false\""
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^17.0.4",
    "@angular/cdk": "^17.0.1",
    "@angular/common": "^17.0.4",
    "@angular/compiler": "^17.0.4",
    "@angular/core": "^17.0.4",
    "@angular/fire": "^17.0.0-next.0",
    "@angular/forms": "^17.0.4",
    "@angular/material": "^17.0.1",
    "@angular/platform-browser": "^17.0.4",
    "@angular/platform-browser-dynamic": "^17.0.4",
    "@angular/router": "^17.0.4",
    "@angular/service-worker": "^17.0.4",
    "chart.js": "^2.9.4",
    "chartjs-gauge": "^0.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.2"
  },
  "devDependencies": {
    "@angular-devkit/architect": "^0.1700.2",
    "@angular-devkit/build-angular": "^17.0.2",
    "@angular/cli": "~17.0.2",
    "@angular/compiler-cli": "^17.0.4",
    "@angular/localize": "^17.0.4",
    "@localazy/cli": "^1.7.5",
    "@types/chart.js": "^2.9.38",
    "@types/jasmine": "~4.3.0",
    "jasmine-core": "~4.6.0",
    "json": "^11.0.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.2.2"
  }
}